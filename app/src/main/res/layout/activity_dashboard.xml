<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_light"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- ENCABEZADO -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:layout_marginTop="8dp">

            <TextView
                android:id="@+id/tvBienvenida"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Hola, Usuaria"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/purple_primary"
                android:layout_centerVertical="true"/>

            <Button
                android:id="@+id/btnCerrarSesion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:text="Cerrar Sesión"
                android:textColor="@color/white"
                android:backgroundTint="@color/red_panic"
                app:cornerRadius="20dp"
                android:textSize="12sp"
                android:minHeight="36dp"/>
        </RelativeLayout>

        <!-- TARJETA 1: EMERGENCIA (Prioridad en móvil va arriba) -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardElevation="4dp"
            android:layout_marginBottom="16dp"
            app:cardBackgroundColor="@color/white">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Módulo de Emergencia"
                    android:textColor="@color/red_panic"
                    android:textStyle="bold"
                    android:textSize="18sp"
                    android:layout_marginBottom="8dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Accede a tus redes de apoyo y herramientas de seguridad."
                    android:textSize="13sp"
                    android:textColor="@color/text_gray"
                    android:layout_marginBottom="16dp"/>

                <Button
                    android:id="@+id/btnIrEmergencia"
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:text="Círculo de Cuidado"
                    android:textColor="@color/white"
                    android:backgroundTint="@color/red_panic"
                    android:textStyle="bold"
                    android:textSize="16sp"
                    app:cornerRadius="8dp"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- TARJETA 2: EDUCACIÓN -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp"
            android:layout_marginBottom="16dp"
            app:cardBackgroundColor="@color/white">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Educación Sexual Integral"
                    android:textColor="@color/purple_primary"
                    android:textStyle="bold"
                    android:textSize="18sp"
                    android:layout_marginBottom="16dp"/>

                <Button
                    android:id="@+id/btnIrEducacion"
                    android:layout_width="match_parent"
                    android:layout_height="55dp"
                    android:text="Ver Módulos Educativos"
                    android:textColor="@color/purple_primary"
                    android:backgroundTint="@color/purple_light"
                    app:cornerRadius="8dp"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- TARJETA 3: MI AGENDA DE AUTOCUIDADO (Calendario Integrado) -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp"
            android:layout_marginBottom="16dp"
            app:cardBackgroundColor="@color/white">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Mi Agenda de Autocuidado"
                    android:textColor="@color/purple_primary"
                    android:textStyle="bold"
                    android:textSize="18sp"
                    android:layout_marginBottom="8dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Calendario del Ciclo Menstrual"
                    android:textStyle="bold"
                    android:textSize="14sp"
                    android:layout_marginBottom="12dp"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="16dp">

                    <EditText
                        android:id="@+id/etFechaInicioDashboard"
                        android:layout_width="0dp"
                        android:layout_height="50dp"
                        android:layout_weight="1"
                        android:background="@drawable/edittext_border"
                        android:hint="Inicio (Clic)"
                        android:textAlignment="center"
                        android:focusable="false"
                        android:clickable="true"
                        android:layout_marginEnd="8dp"/>

                    <EditText
                        android:id="@+id/etFechaFinDashboard"
                        android:layout_width="0dp"
                        android:layout_height="50dp"
                        android:layout_weight="1"
                        android:background="@drawable/edittext_border"
                        android:hint="Término (Clic)"
                        android:textAlignment="center"
                        android:focusable="false"
                        android:clickable="true"/>
                </LinearLayout>

                <Button
                    android:id="@+id/btnGuardarCicloDashboard"
                    android:layout_width="match_parent"
                    android:layout_height="55dp"
                    android:text="Guardar Ciclo Menstrual"
                    android:textColor="@color/purple_primary"
                    android:backgroundTint="@color/purple_light"
                    app:cornerRadius="8dp"
                    android:layout_marginBottom="16dp"/>

                <!-- Contenedor del Historial de Ciclos -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="HISTORIAL DE REGISTROS"
                    android:textStyle="bold"
                    android:textSize="12sp"
                    android:textColor="@color/text_gray"
                    android:layout_marginBottom="8dp"/>

                <LinearLayout
                    android:id="@+id/layoutHistorialCiclos"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <!-- Los registros aparecerán aquí dinámicamente -->
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- TARJETA 4: AGENDA MÉDICA PREVENTIVA -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardAgendaMedica"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp"
            android:layout_marginBottom="16dp"
            app:cardBackgroundColor="#FFF0F5">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Agenda Médica Preventiva (CESFAM)"
                    android:textColor="@color/red_panic"
                    android:textStyle="bold"
                    android:textSize="16sp"
                    android:layout_marginBottom="12dp"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="16dp">

                    <EditText
                        android:id="@+id/etFechaCita"
                        android:layout_width="0dp"
                        android:layout_height="50dp"
                        android:layout_weight="1"
                        android:background="@drawable/edittext_border"
                        android:hint="Fecha (Clic)"
                        android:textAlignment="center"
                        android:focusable="false"
                        android:clickable="true"
                        android:layout_marginEnd="8dp"/>

                    <EditText
                        android:id="@+id/etEspecialidad"
                        android:layout_width="0dp"
                        android:layout_height="50dp"
                        android:layout_weight="1.5"
                        android:background="@drawable/edittext_border"
                        android:hint="Ej: Matrona"
                        android:paddingStart="8dp"/>
                </LinearLayout>

                <Button
                    android:id="@+id/btnAgendarCita"
                    android:layout_width="match_parent"
                    android:layout_height="55dp"
                    android:text="Agendar Nueva Cita"
                    android:textColor="@color/red_panic"
                    android:backgroundTint="@color/red_panic_light"
                    app:cornerRadius="8dp"
                    android:layout_marginBottom="16dp"/>

                <!-- Contenedor de Próximas Citas -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="PRÓXIMAS CITAS AGENDADAS"
                    android:textStyle="bold"
                    android:textSize="12sp"
                    android:textColor="@color/red_panic"
                    android:layout_marginBottom="8dp"/>

                <LinearLayout
                    android:id="@+id/layoutCitasAgendadas"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <!-- Las citas aparecerán aquí dinámicamente -->
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- TARJETA 5: ORIENTACIÓN TERRITORIAL (Red de Apoyo) -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp"
            android:layout_marginBottom="32dp"
            app:cardBackgroundColor="@color/white">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Orientación Territorial"
                    android:textColor="@color/purple_primary"
                    android:textStyle="bold"
                    android:textSize="18sp"
                    android:layout_marginBottom="16dp"/>

                <Button
                    android:id="@+id/btnIrRedApoyo"
                    android:layout_width="match_parent"
                    android:layout_height="55dp"
                    android:text="Ver Red de Salud Local"
                    android:textColor="@color/purple_primary"
                    android:backgroundTint="@color/purple_light"
                    app:cornerRadius="8dp"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

    </LinearLayout>
</ScrollView>