<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:gravity="center_horizontal">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Módulo Educativo"
        android:textSize="26sp"
        android:textStyle="bold"
        android:textColor="#800080"
        android:layout_marginBottom="16dp"/>

    <TextView
        android:id="@+id/tvEnfoquePedagogico"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Enfoque Pedagógico:"
        android:textSize="16sp"
        android:textStyle="italic"
        android:layout_marginBottom="24dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Temas Habilitados para ti:"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp"/>

    <ListView
        android:id="@+id/lvTemas"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginBottom="16dp"/>

    <Button
        android:id="@+id/btnIrCitas"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Agendar Cita Médica"
        android:backgroundTint="#800080"
        android:visibility="gone"/>
    <!-- Inicialmente oculto (gone), lo mostraremos sólo si el perfil lo permite -->

</LinearLayout>