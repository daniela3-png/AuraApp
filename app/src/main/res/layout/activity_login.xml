<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="32dp"
    android:gravity="center"
    android:background="#FDF8FF">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Bienvenida a Aura"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="#6C5CE7"
        android:layout_marginBottom="32dp"/>

    <!-- ID exacto que busca el Java en la línea 43 -->
    <EditText
        android:id="@+id/etCorreoLogin"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:hint="Correo Electrónico"
        android:inputType="textEmailAddress"
        android:background="#FFFFFF"
        android:paddingHorizontal="16dp"
        android:layout_marginBottom="16dp"/>

    <!-- ID exacto que busca el Java en la línea 44 -->
    <EditText
        android:id="@+id/etPinLogin"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:hint="PIN de 4 dígitos"
        android:inputType="numberPassword"
        android:maxLength="4"
        android:background="#FFFFFF"
        android:paddingHorizontal="16dp"
        android:layout_marginBottom="24dp"/>

    <Button
        android:id="@+id/btnIngresar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="Iniciar Sesión"
        android:textColor="#FFFFFF"
        android:backgroundTint="#6C5CE7"
        android:textStyle="bold"
        app:cornerRadius="8dp"
        android:layout_marginBottom="16dp"/>

    <TextView
        android:id="@+id/tvIrRegistro"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="¿No tienes cuenta? Regístrate aquí"
        android:textColor="#E84393"
        android:textStyle="bold"
        android:padding="8dp"/>

</LinearLayout>