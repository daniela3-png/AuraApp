<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#FDF8FF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="32dp"
        android:gravity="center_horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Crea tu Perfil en Aura"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="#6C5CE7"
            android:layout_marginBottom="24dp"/>

        <EditText
            android:id="@+id/etNombre"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="¿Cómo te llamas?"
            android:inputType="textPersonName"
            android:layout_marginBottom="16dp"/>

        <!-- NUEVO: Campo de Correo Electrónico -->
        <EditText
            android:id="@+id/etEmail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Correo Electrónico"
            android:inputType="textEmailAddress"
            android:layout_marginBottom="16dp"/>

        <!-- NUEVO: Campo de Fecha de Nacimiento -->
        <EditText
            android:id="@+id/etFechaNacimiento"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Fecha de Nacimiento"
            android:focusable="false"
            android:clickable="true"
            android:layout_marginBottom="16dp"/>

        <EditText
            android:id="@+id/etPin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Crea un PIN de 4 dígitos"
            android:inputType="numberPassword"
            android:maxLength="4"
            android:layout_marginBottom="16dp"/>

        <!-- SECCIÓN DEL TUTOR (Oculta por defecto) -->
        <LinearLayout
            android:id="@+id/layoutTutor"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            android:background="#FFE6F0"
            android:padding="16dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Autorización de Tutor/Cuidador"
                android:textStyle="bold"
                android:textColor="#E84393"
                android:layout_marginBottom="8dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Por tu edad, necesitamos vincular la cuenta de un adulto responsable."
                android:textColor="#1E1638"
                android:textSize="12sp"
                android:layout_marginBottom="8dp"/>

            <EditText
                android:id="@+id/etNombreTutor"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Nombre del Tutor"
                android:inputType="textPersonName"/>
        </LinearLayout>

        <Button
            android:id="@+id/btnRegistrar"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Guardar y Continuar"
            android:backgroundTint="#6C5CE7"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:layout_marginTop="16dp"/>

    </LinearLayout>
</ScrollView>