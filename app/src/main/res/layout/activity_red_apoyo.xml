<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_light"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Red de Apoyo Asistencial"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@color/purple_primary"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Encuentra el centro de salud de Iquique más cercano para recibir orientación, atención o retirar métodos anticonceptivos."
            android:textSize="14sp"
            android:textColor="@color/text_gray"
            android:layout_marginBottom="24dp"/>

        <!-- TARJETA 1: CESFAM Cirujano Videla -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp"
            android:layout_marginBottom="16dp"
            app:cardBackgroundColor="@color/white">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="CESFAM Cirujano Videla"
                    android:textColor="@color/purple_primary"
                    android:textStyle="bold"
                    android:textSize="18sp"
                    android:layout_marginBottom="4dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Arturo Pérez Canto 1300, Iquique"
                    android:textSize="13sp"
                    android:textColor="@color/text_gray"
                    android:layout_marginBottom="16dp"/>

                <Button
                    android:id="@+id/btnRutaVidela"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:text="📍 Ver Ruta en Mapa"
                    android:textColor="@color/white"
                    android:backgroundTint="@color/purple_primary"
                    app:cornerRadius="8dp"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- TARJETA 2: CESFAM Cirujano Aguirre -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp"
            android:layout_marginBottom="16dp"
            app:cardBackgroundColor="@color/white">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="CESFAM Cirujano Aguirre"
                    android:textColor="@color/purple_primary"
                    android:textStyle="bold"
                    android:textSize="18sp"
                    android:layout_marginBottom="4dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Serrano 135, Iquique"
                    android:textSize="13sp"
                    android:textColor="@color/text_gray"
                    android:layout_marginBottom="16dp"/>

                <Button
                    android:id="@+id/btnRutaAguirre"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:text="📍 Ver Ruta en Mapa"
                    android:textColor="@color/white"
                    android:backgroundTint="@color/purple_primary"
                    app:cornerRadius="8dp"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- TARJETA 3: CESFAM Cirujano Guzmán -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp"
            android:layout_marginBottom="16dp"
            app:cardBackgroundColor="@color/white">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="CESFAM Cirujano Guzmán"
                    android:textColor="@color/purple_primary"
                    android:textStyle="bold"
                    android:textSize="18sp"
                    android:layout_marginBottom="4dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Av. Las Rosas 2561, Iquique"
                    android:textSize="13sp"
                    android:textColor="@color/text_gray"
                    android:layout_marginBottom="16dp"/>

                <Button
                    android:id="@+id/btnRutaGuzman"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:text="📍 Ver Ruta en Mapa"
                    android:textColor="@color/white"
                    android:backgroundTint="@color/purple_primary"
                    app:cornerRadius="8dp"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- TARJETA 4: CESFAM Sur -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp"
            android:layout_marginBottom="16dp"
            app:cardBackgroundColor="@color/white">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="CESFAM Sur"
                    android:textColor="@color/purple_primary"
                    android:textStyle="bold"
                    android:textSize="18sp"
                    android:layout_marginBottom="4dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Cerro Dragón 3320, Iquique"
                    android:textSize="13sp"
                    android:textColor="@color/text_gray"
                    android:layout_marginBottom="16dp"/>

                <Button
                    android:id="@+id/btnRutaSur"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:text="📍 Ver Ruta en Mapa"
                    android:textColor="@color/white"
                    android:backgroundTint="@color/purple_primary"
                    app:cornerRadius="8dp"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- TARJETA 5: Hospital Regional -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp"
            android:layout_marginBottom="32dp"
            app:cardBackgroundColor="@color/white">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Hospital Regional Dr. Ernesto Torres"
                    android:textColor="@color/purple_primary"
                    android:textStyle="bold"
                    android:textSize="18sp"
                    android:layout_marginBottom="4dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Av. Héroes de la Concepción 502, Iquique"
                    android:textSize="13sp"
                    android:textColor="@color/text_gray"
                    android:layout_marginBottom="16dp"/>

                <Button
                    android:id="@+id/btnRutaHospital"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:text="📍 Ver Ruta en Mapa"
                    android:textColor="@color/white"
                    android:backgroundTint="@color/purple_primary"
                    app:cornerRadius="8dp"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

    </LinearLayout>
</ScrollView>