<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="32dp"
    android:gravity="center"
    android:background="#FFF0F0"> <!-- Fondo ligeramente rojizo para alerta -->

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Módulo de Seguridad"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="#D32F2F"
        android:layout_marginBottom="48dp"/>

    <!-- Este es el Botón de Pánico -->
    <Button
        android:id="@+id/btnPanico"
        android:layout_width="200dp"
        android:layout_height="200dp"
        android:text="SOS"
        android:textSize="48sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:backgroundTint="#D32F2F"
        android:layout_marginBottom="32dp"
        android:elevation="8dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Al presionar, se enviará tu ubicación a tus contactos de emergencia."
        android:textAlignment="center"
        android:textSize="14sp"/>
</LinearLayout>