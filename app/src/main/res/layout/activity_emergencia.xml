<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_light"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Módulo de Emergencia"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@color/red_panic"
            android:layout_marginBottom="24dp"/>

        <!-- TARJETA 1: BOTÓN DE PÁNICO DE AURA -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardElevation="4dp"
            android:layout_marginBottom="24dp"
            app:cardBackgroundColor="@color/white">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp"
                android:gravity="center">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Notificar a mi Tutor"
                    android:textColor="@color/red_panic"
                    android:textStyle="bold"
                    android:textSize="18sp"
                    android:layout_marginBottom="8dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Envía un SMS con tu ubicación actual al número de tu apoderado o contacto de confianza."
                    android:textSize="14sp"
                    android:textAlignment="center"
                    android:textColor="@color/text_gray"
                    android:layout_marginBottom="24dp"/>

                <Button
                    android:id="@+id/btnEnviarAlerta"
                    android:layout_width="match_parent"
                    android:layout_height="70dp"
                    android:text="🚨 ENVIAR ALERTA"
                    android:textColor="@color/white"
                    android:backgroundTint="@color/red_panic"
                    android:textStyle="bold"
                    android:textSize="18sp"
                    app:cornerRadius="35dp"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- TARJETA 2: EDUCACIÓN SOS NATIVO DE ANDROID -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp"
            android:layout_marginBottom="16dp"
            app:cardBackgroundColor="#FFF0F5"> <!-- Fondo rojo muy claro/rosado -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="💡 Atajo con Pantalla Bloqueada"
                    android:textColor="@color/red_panic"
                    android:textStyle="bold"
                    android:textSize="16sp"
                    android:layout_marginBottom="12dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tu celular tiene una función de emergencia oculta. No necesitas abrir Aura ni desbloquear la pantalla para pedir ayuda rápida."
                    android:textSize="14sp"
                    android:textColor="@color/text_gray"
                    android:layout_marginBottom="12dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="1. Presiona el botón de encendido de tu celular 5 veces seguidas rápidamente.\n2. Esto activará el 'SOS de Emergencia' del sistema.\n3. Configura tus contactos de emergencia en los Ajustes generales de tu teléfono."
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/red_panic"
                    android:lineSpacingExtra="4dp"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- TARJETA 3: CONTACTOS DE EMERGENCIA -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp"
            android:layout_marginBottom="32dp"
            app:cardBackgroundColor="@color/white">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Mis Contactos de Confianza"
                    android:textColor="@color/purple_primary"
                    android:textStyle="bold"
                    android:textSize="18sp"
                    android:layout_marginBottom="16dp"/>

                <EditText
                    android:id="@+id/etContacto1"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:background="@drawable/edittext_border"
                    android:hint="Contacto 1 (Ej: Mamá - +569...)"
                    android:paddingStart="12dp"
                    android:layout_marginBottom="12dp"/>

                <EditText
                    android:id="@+id/etContacto2"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:background="@drawable/edittext_border"
                    android:hint="Contacto 2 (Ej: Tutor - +569...)"
                    android:paddingStart="12dp"
                    android:layout_marginBottom="12dp"/>

                <EditText
                    android:id="@+id/etContacto3"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:background="@drawable/edittext_border"
                    android:hint="Contacto 3 (Opcional)"
                    android:paddingStart="12dp"
                    android:layout_marginBottom="16dp"/>

                <Button
                    android:id="@+id/btnGuardarContactos"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:text="Guardar Cambios"
                    android:textColor="@color/purple_primary"
                    android:backgroundTint="@color/purple_light"
                    app:cornerRadius="8dp"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

    </LinearLayout>
</ScrollView>